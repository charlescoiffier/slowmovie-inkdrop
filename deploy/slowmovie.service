[Unit]
Description=SlowMovie-Inkdrop
After=network-online.target
Wants=network-online.target

[Service]
User=admin
Environment=SLOWMOVIE_HOME=/home/admin/SlowMovie
WorkingDirectory=/home/admin/SlowMovie
# Petite attente au démarrage (reprise de l'ancien service, qui fonctionnait ainsi sur le Zero 2 W)
ExecStartPre=/bin/sleep 10
ExecStart=/home/admin/.SlowMovie/bin/slowmovie run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

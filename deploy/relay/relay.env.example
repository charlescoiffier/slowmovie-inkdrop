# À placer dans ~/srv/slowmovie/.env sur le VPS (chmod 600, jamais dans git).
# Résultat de : slowmovie-relay hash-password   (sans '$' : sûr dans un fichier .env de compose)
SLOWMOVIE_RELAY_PASSWORD_HASH=scrypt:...
# Chaîne aléatoire longue : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SLOWMOVIE_RELAY_DEVICE_TOKEN=...
# Déjà à 1 dans l'image (le relais est derrière Traefik) ; les données sont dans /data.
# Facultatif :
# SLOWMOVIE_RELAY_MAX_DURATION=3600
# SLOWMOVIE_RELAY_QUEUE_MAX=10
# SLOWMOVIE_RELAY_CAPTION_MAX=128

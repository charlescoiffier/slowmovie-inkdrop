# À placer dans ~/srv/inkdrop/.env sur le VPS (chmod 600, jamais dans git).
# Résultat de : slowmovie-relay hash-password   (sans '$' : sûr dans un fichier .env de compose)
SLOWMOVIE_RELAY_PASSWORD_HASH=scrypt:...
# Chaîne aléatoire longue : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SLOWMOVIE_RELAY_DEVICE_TOKEN=...
# Déjà à 1 dans l'image (le relais est derrière Traefik) ; les données sont dans /data.
# Facultatif :
# SLOWMOVIE_RELAY_MAX_DURATION=3600
# SLOWMOVIE_RELAY_QUEUE_MAX=10
# SLOWMOVIE_RELAY_CAPTION_MAX=128

# Administration de la passerelle (onglet « Réglages »). Sans haché, l'onglet est désactivé.
# Résultat de : slowmovie-relay hash-password   (mot de passe DIFFÉRENT de celui des envois)
SLOWMOVIE_RELAY_ADMIN_PASSWORD_HASH=scrypt:...
# Facultatif : clé de signature des sessions ; sans elle, les sessions sautent à chaque redéploiement.
# SLOWMOVIE_RELAY_SESSION_SECRET=<chaîne aléatoire longue>
